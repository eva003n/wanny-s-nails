ARG NODE_VERSION=22.21.1
ARG PNPM_VERSION=10.32.1

FROM node:${NODE_VERSION}-alpine AS base
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
# Required for Prisma's query/migration engine on Alpine (musl)
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# pnpm needs every workspace member's package.json present to resolve the
# workspace graph, even though --filter below only installs deps for one
# of them. Your workspace has 6 members — list them all explicitly so the
# build doesn't depend on glob support varying across BuildKit versions.
COPY apps/api/package.json ./apps/api/package.json
COPY apps/packages/package.json ./apps/packages/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/workers/notification/package.json ./apps/workers/notification/package.json
COPY apps/workers/payment/package.json ./apps/workers/payment/package.json
COPY apps/workers/conversation/package.json ./apps/workers/conversation/package.json
RUN pnpm install --frozen-lockfile --filter ./apps/packages...

# Generate the Prisma Client inside the build, rather than relying on
# apps/packages/src/generated already existing on the host (it's typically
# gitignored, so a host-side COPY can silently grab nothing or stale output).
COPY apps/packages/prisma ./apps/packages/prisma
WORKDIR /app/apps/packages
# prisma.config.ts uses env("DATABASE_URL"), which throws if unset — even
# for `prisma generate`, which never actually connects to a database. A
# placeholder satisfies the check without needing the real value at build time.
RUN DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder" \
    pnpm exec prisma generate --config prisma/prisma.config.ts
WORKDIR /app

FROM base AS runtime
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/packages/node_modules ./apps/packages/node_modules
COPY apps/packages/package.json ./apps/packages/package.json
COPY apps/packages/prisma ./apps/packages/prisma

# Generated client comes from the deps stage build, not the host filesystem —
# guarantees it's always fresh and always present regardless of .gitignore
# or whether anyone ran `prisma generate` locally before building.
COPY --from=deps /app/apps/packages/src/generated ./apps/packages/src/generated

WORKDIR /app/apps/packages

# ENTRYPOINT fixed, CMD swappable — lets you override just the prisma
# subcommand at `docker run` time instead of replacing the whole entrypoint.
ENTRYPOINT ["pnpm", "exec", "prisma"]
CMD ["migrate", "deploy", "--config", "prisma/prisma.config.ts"]