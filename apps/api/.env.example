# Base url
BASE_URL=http://localhost:8000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wannys_nails?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-random-32-char-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN=http://localhost:5173

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
META_APP_SECRET=""
# M-Pesa Daraja API
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_STK_PUSH_URL=""
DARAJA_CALLBACK_URL=""

# Email (Resend)
RESEND_API_KEY=""

# Gemini AI (fallback)
GEMINI_API_KEY=""

# App metadata / logging
APP_NAME="Wanny's Nails"
LOG_LEVEL=info
LOGTAIL_INGESTION_HOST=""
LOGTAIL_SOURCE_TOKEN=""

# App(.env)
NODE_ENV=development
PORT=8000