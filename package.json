{
  "name": "wannys-nails",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:api": "cd apps/api && pnpm dev",
    "dev:web": "cd apps/web && pnpm dev",
    "prisma:validate": "cd apps/api && pnpm prisma validate",
    "prisma:generate": "cd apps/api && pnpm dlx prisma generate",
    "prisma:migrate": "cd apps/api && pnpm  prisma migrate",
    "typecheck": "tsc --noEmit",
    "test": "cd apps/web && pnpm test"
  },
  "dependencies": {
    "pino-pretty": "^13.1.3"
  }
}